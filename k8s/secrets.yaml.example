# Create actual secrets.yaml from this template
# kubectl create secret generic customer-support-secrets \
#   --from-literal=OPENAI_API_KEY=your-key \
#   --from-literal=DATABASE_URL=postgresql://user:pass@host/db \
#   --from-literal=POSTGRES_PASSWORD=your-password \
#   -n customer-support

apiVersion: v1
kind: Secret
metadata:
  name: customer-support-secrets
  namespace: customer-support
type: Opaque
stringData:
  OPENAI_API_KEY: "sk-replace-with-actual-key"
  DATABASE_URL: "postgresql://postgres:password@postgres-service:5432/customer_support"
  POSTGRES_PASSWORD: "replace-with-secure-password"
